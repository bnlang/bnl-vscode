{
    "If": {
        "prefix": ["if"],
        "body": ["if (${1:cond}) {", "    ${0}", "}"],
        "description": "if block"
    },
    "If-Else": {
        "prefix": ["ife", "if-else"],
        "body": ["if (${1:cond}) {", "    ${2}", "} else {", "    ${0}", "}"],
        "description": "if / else block"
    },
    "While": {
        "prefix": ["while"],
        "body": ["while (${1:cond}) {", "    ${0}", "}"],
        "description": "while loop"
    },
    "For-of": {
        "prefix": ["for", "for-of"],
        "body": ["for (var ${1:item} of ${2:list}) {", "    ${0}", "}"],
        "description": "for ... of loop"
    },
    "Switch": {
        "prefix": ["switch"],
        "body": [
            "switch (${1:value}) {",
            "    case ${2:value1}: { ${3} }",
            "    default: { ${0} }",
            "}"
        ],
        "description": "switch / case / default (no fall-through; each case is its own block)"
    },
    "Break": {
        "prefix": ["break"],
        "body": ["break;"],
        "description": "exit the nearest loop or switch"
    },
    "Continue": {
        "prefix": ["continue"],
        "body": ["continue;"],
        "description": "skip to the next iteration of the nearest loop"
    },
    "Function": {
        "prefix": ["fn", "function"],
        "body": ["function ${1:name}(${2:params}) {", "    ${0}", "}"],
        "description": "function declaration"
    },
    "Anonymous function": {
        "prefix": ["fn-anon", "lambda"],
        "body": ["function (${1:params}) { ${0} }"],
        "description": "anonymous function expression"
    },
    "Return": {
        "prefix": ["return"],
        "body": ["return ${0:value};"],
        "description": "return statement"
    },
    "Var": {
        "prefix": ["var"],
        "body": ["var ${1:name} = ${0:value};"],
        "description": "variable declaration"
    },
    "Class": {
        "prefix": ["class"],
        "body": [
            "class ${1:Name} {",
            "    function init(self${2:, args}) {",
            "        ${0}",
            "    }",
            "}"
        ],
        "description": "class with init"
    },
    "Class extends": {
        "prefix": ["class-extends"],
        "body": [
            "class ${1:Child} extends ${2:Parent} {",
            "    function init(self${3:, args}) {",
            "        super(${4});",
            "        ${0}",
            "    }",
            "}"
        ],
        "description": "class with parent + super(...)"
    },
    "Method": {
        "prefix": ["method"],
        "body": ["function ${1:name}(self${2:, args}) {", "    ${0}", "}"],
        "description": "class method (first param is self)"
    },
    "Import (relative)": {
        "prefix": ["import"],
        "body": ["import \"${1:./path.bnl}\" as ${0:alias};"],
        "description": "import a relative bnl source file"
    },
    "Import (built-in)": {
        "prefix": ["import-builtin"],
        "body": ["import \"${1|sys,io,path,time,timers,log,json,crypto,regex,math,random,uuid,csv,dotenv,cli,web,request,ws,template,cookie,session,multipart,net,dns,tls,url,zlib,sqlite,pg,mysql,mongo,exec,test|}\" as ${1};"],
        "description": "import a standard-library module"
    },
    "Import (dep)": {
        "prefix": ["import-dep"],
        "body": ["import \"${1:dep-name}\" as ${0:alias};"],
        "description": "import a deps/<name>/ package"
    },
    "Try-Catch": {
        "prefix": ["try"],
        "body": ["try {", "    ${1}", "} catch (${2:e}) {", "    ${0}", "}"],
        "description": "try / catch block"
    },
    "Try-Catch-Finally": {
        "prefix": ["tcf", "try-catch-finally"],
        "body": [
            "try {",
            "    ${1}",
            "} catch (${2:e}) {",
            "    ${3}",
            "} finally {",
            "    ${0}",
            "}"
        ],
        "description": "try / catch / finally"
    },
    "Try-Finally (no catch)": {
        "prefix": ["tf", "try-finally"],
        "body": ["try {", "    ${1}", "} finally {", "    ${0}", "}"],
        "description": "try / finally without catch"
    },
    "Throw": {
        "prefix": ["throw"],
        "body": ["throw ${0:value};"],
        "description": "throw a value"
    },
    "Try-Call (no-syntax catch)": {
        "prefix": ["try_call"],
        "body": [
            "var ${1:result} = try_call(",
            "    function () { return ${2:risky()}; },",
            "    function (${3:err}) { return ${0:fallback}; }",
            ");"
        ],
        "description": "try_call(thunk, on_err) — recovers as an expression"
    },
    "Print": {
        "prefix": ["print"],
        "body": ["print(${0});"],
        "description": "print to stdout (newline appended)"
    },
    "Wait": {
        "prefix": ["wait"],
        "body": ["wait ${0:future_expr}"],
        "description": "wait on a Future inside an async function — suspends until it settles"
    },
    "Future executor": {
        "prefix": ["future", "Future"],
        "body": [
            "Future(function (resolve, reject) {",
            "    ${0}",
            "})"
        ],
        "description": "construct a new Future from an (resolve, reject) executor"
    },
    "Future.of (resolved)": {
        "prefix": ["future-of", "Future.of"],
        "body": ["Future.of(${0:value})"],
        "description": "an already-fulfilled Future"
    },
    "Future.err (rejected)": {
        "prefix": ["future-err", "Future.err"],
        "body": ["Future.err(${0:reason})"],
        "description": "an already-rejected Future"
    },
    "Future.all": {
        "prefix": ["future-all", "Future.all"],
        "body": ["Future.all([${0}])"],
        "description": "wait for every Future to fulfill, or reject on the first failure"
    },
    "Futurify a callback fn": {
        "prefix": ["futurify"],
        "body": ["var ${1:wrapped} = futurify(${0:callback_style_fn});"],
        "description": "convert a callback-style function (last arg = (err, result) cb) into one that returns a Future"
    },
    "Async function skeleton": {
        "prefix": ["fn-async", "async-fn"],
        "body": [
            "function ${1:name}(${2:params}) {",
            "    var ${3:result} = wait ${4:future_expr};",
            "    return ${0:result};",
            "}"
        ],
        "description": "function containing a wait — caller gets back a Future"
    },
    "List literal": {
        "prefix": ["list"],
        "body": ["[${0}]"]
    },
    "Map literal": {
        "prefix": ["map"],
        "body": ["{${1:key}: ${0:value}}"]
    },
    "Index loop": {
        "prefix": ["loop-i", "index-loop"],
        "body": [
            "var ${1:i} = 0;",
            "while (${1:i} < ${2:xs}.length) {",
            "    ${0:print(${2:xs}[${1:i}]);}",
            "    ${1:i} = ${1:i} + 1;",
            "}"
        ],
        "description": "iterate a list by index (use when you need the index; otherwise prefer `for ... of`)"
    },

    "যদি (Bangla)": {
        "prefix": ["যদি"],
        "body": ["যদি (${1:শর্ত}) {", "    ${0}", "}"],
        "description": "if (Bangla)"
    },
    "যদি / নাহলে (Bangla)": {
        "prefix": ["যদি-নাহলে"],
        "body": ["যদি (${1:শর্ত}) {", "    ${2}", "} নাহলে {", "    ${0}", "}"],
        "description": "if / else (Bangla)"
    },
    "যতক্ষণ (Bangla)": {
        "prefix": ["যতক্ষণ"],
        "body": ["যতক্ষণ (${1:শর্ত}) {", "    ${0}", "}"],
        "description": "while (Bangla)"
    },
    "প্রতি ... এর (Bangla)": {
        "prefix": ["প্রতি"],
        "body": ["প্রতি (চলক ${1:item} এর ${2:list}) {", "    ${0}", "}"],
        "description": "for ... of (Bangla)"
    },
    "বিকল্প (Bangla)": {
        "prefix": ["বিকল্প"],
        "body": [
            "বিকল্প (${1:value}) {",
            "    অবস্থা ${2:value1}: { ${3} }",
            "    অন্যথায়: { ${0} }",
            "}"
        ],
        "description": "switch / case / default (Bangla)"
    },
    "থামুন (Bangla)": {
        "prefix": ["থামুন"],
        "body": ["থামুন;"],
        "description": "break (Bangla)"
    },
    "চলুন (Bangla)": {
        "prefix": ["চলুন"],
        "body": ["চলুন;"],
        "description": "continue (Bangla)"
    },
    "ফাংশন (Bangla)": {
        "prefix": ["ফাংশন"],
        "body": ["ফাংশন ${1:name}(${2:params}) {", "    ${0}", "}"],
        "description": "function (Bangla)"
    },
    "শ্রেণী (Bangla)": {
        "prefix": ["শ্রেণী"],
        "body": [
            "শ্রেণী ${1:Name} {",
            "    ফাংশন init(self${2:, args}) {",
            "        ${0}",
            "    }",
            "}"
        ],
        "description": "class (Bangla)"
    },
    "চলক (Bangla)": {
        "prefix": ["চলক"],
        "body": ["চলক ${1:name} = ${0:value};"],
        "description": "var declaration (Bangla)"
    },
    "ফেরত (Bangla)": {
        "prefix": ["ফেরত"],
        "body": ["ফেরত ${0:value};"],
        "description": "return (Bangla)"
    },
    "চেষ্টা / ধরুন (Bangla)": {
        "prefix": ["চেষ্টা"],
        "body": ["চেষ্টা {", "    ${1}", "} ধরুন (${2:ভুল}) {", "    ${0}", "}"],
        "description": "try / catch (Bangla)"
    },
    "চেষ্টা / ধরুন / অবশেষে (Bangla)": {
        "prefix": ["চেষ্টা-অবশেষে"],
        "body": [
            "চেষ্টা {",
            "    ${1}",
            "} ধরুন (${2:ভুল}) {",
            "    ${3}",
            "} অবশেষে {",
            "    ${0}",
            "}"
        ],
        "description": "try / catch / finally (Bangla)"
    },
    "নিক্ষেপ (Bangla)": {
        "prefix": ["নিক্ষেপ"],
        "body": ["নিক্ষেপ ${0:value};"],
        "description": "throw (Bangla)"
    },
    "আমদানি (Bangla)": {
        "prefix": ["আমদানি"],
        "body": ["আমদানি \"${1:path}\" যেমন ${0:নাম};"],
        "description": "import (Bangla)"
    },
    "অপেক্ষা (Bangla)": {
        "prefix": ["অপেক্ষা"],
        "body": ["অপেক্ষা ${0:future_expr}"],
        "description": "wait (Bangla)"
    }
}
